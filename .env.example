# Copia este archivo como .env y ajusta los valores
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fiadoclaro
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fiadoclaro_test

# Genera una clave larga, por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esta-clave-larga-en-produccion-0123456789
JWT_EXPIRE_MINUTES=480

TIMEZONE=America/Lima

ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123*

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
