// FiadoClaro - Modelo de base de datos (PostgreSQL)
// Pega este archivo en https://dbdiagram.io para ver el diagrama.
// Montos: numeric(12,2). Tasas en porcentaje: numeric(12,7). Tasas derivadas (fracción): numeric(16,10).

Project FiadoClaro {
  database_type: 'PostgreSQL'
}

Table tienda {
  id serial [pk]
  ruc varchar(11) [unique, not null, note: '11 dígitos']
  razon_social varchar(150) [not null]
  nombre_comercial varchar(120) [not null]
  giro varchar(40) [not null, note: 'Bodega, Frutería, Peluquería...']
  direccion varchar(200)
  distrito varchar(80)
  telefono varchar(20)
  correo varchar(120)
  estado varchar(10) [not null, note: 'ACTIVA | BAJA']
  fecha_baja timestamptz
  created_at timestamptz
  updated_at timestamptz
}

Table usuario {
  id serial [pk]
  username varchar(60) [unique, not null]
  password_hash varchar(255) [not null, note: 'Argon2']
  rol varchar(20) [not null, note: 'ADMIN_SISTEMA | ADMIN_TIENDA | CLIENTE']
  tienda_id int [ref: > tienda.id, note: 'NULL solo para ADMIN_SISTEMA']
  nombre varchar(120) [not null]
  activo boolean [not null]
  ultimo_acceso timestamptz
  created_at timestamptz
  updated_at timestamptz
}

Table cliente {
  id serial [pk]
  tienda_id int [not null, ref: > tienda.id]
  usuario_id int [unique, not null, ref: - usuario.id, note: 'acceso al portal']
  dni varchar(8) [not null]
  nombres varchar(80) [not null]
  apellidos varchar(80) [not null]
  telefono varchar(20)
  correo varchar(120)
  direccion varchar(200)
  estado varchar(10) [not null, note: 'ACTIVO | BAJA']
  fecha_baja timestamptz
  created_at timestamptz
  updated_at timestamptz
  indexes { (tienda_id, dni) [unique] }
}

Table condicion_credito {
  cliente_id int [pk, ref: - cliente.id]
  moneda varchar(3) [not null, note: 'PEN | USD']
  tipo_tasa varchar(10) [not null, note: 'NOMINAL | EFECTIVA']
  tasa numeric(12,7) [not null, note: '% compensatoria']
  periodo_tasa_dias smallint [not null, note: '30 mensual, 360 anual']
  capitalizacion_dias smallint [note: 'solo nominal; 1 = diaria']
  tipo_tasa_mora varchar(10) [not null]
  tasa_mora numeric(12,7) [not null, note: '% moratoria']
  periodo_tasa_mora_dias smallint [not null]
  capitalizacion_mora_dias smallint
  limite_credito numeric(12,2) [not null]
  max_meses smallint [not null, note: '1 a 36']
  dia_corte smallint [not null, note: '1 a 28']
  hora_corte time [not null, note: 'ej. 18:00']
  dia_pago smallint [not null, note: '1 a 28, distinto al corte']
  created_at timestamptz
  updated_at timestamptz
}

Table producto {
  id serial [pk]
  tienda_id int [not null, ref: > tienda.id]
  codigo varchar(30) [not null, note: 'SKU']
  nombre varchar(120) [not null]
  descripcion varchar(300)
  marca varchar(60)
  proveedor varchar(120)
  unidad_medida varchar(20) [not null]
  imagen_url varchar(500)
  moneda varchar(3) [not null]
  precio_contado numeric(12,2) [not null]
  precio_lista_credito numeric(12,2) [not null]
  permite_fin_mes boolean [not null]
  permite_cuotas boolean [not null]
  max_meses smallint [note: 'máximo de meses por producto (si permite cuotas)']
  estado varchar(10) [not null, note: 'ACTIVO | BAJA']
  created_at timestamptz
  updated_at timestamptz
  indexes { (tienda_id, codigo) [unique] }
}

Table compra {
  id serial [pk]
  tienda_id int [not null, ref: > tienda.id]
  cliente_id int [not null, ref: > cliente.id]
  registrado_por int [not null, ref: > usuario.id]
  fecha_hora timestamptz [not null]
  modalidad varchar(10) [not null, note: 'FIN_MES | CUOTAS']
  num_cuotas smallint [not null]
  moneda varchar(3) [not null]
  monto_total numeric(12,2) [not null]
  fecha_corte date [not null, note: 'ciclo decidido con fecha y hora de corte']
  fecha_pago date [not null]
  dias_gracia smallint [not null]
  tipo_tasa varchar(10) [not null, note: 'COPIA de la tasa pactada']
  tasa numeric(12,7) [not null]
  periodo_tasa_dias smallint [not null]
  capitalizacion_dias smallint
  tipo_tasa_mora varchar(10) [not null]
  tasa_mora numeric(12,7) [not null]
  periodo_tasa_mora_dias smallint [not null]
  capitalizacion_mora_dias smallint
  tem numeric(16,10) [not null]
  tea numeric(16,10) [not null]
  interes_total numeric(12,2) [not null]
  monto_capitalizado numeric(12,2) [not null]
  valor_cuota numeric(12,2) [not null]
  tcea numeric(16,10)
  estado varchar(10) [not null, note: 'VIGENTE | CANCELADA | ANULADA']
  created_at timestamptz
  updated_at timestamptz
}

Table compra_detalle {
  id serial [pk]
  compra_id int [not null, ref: > compra.id]
  producto_id int [not null, ref: > producto.id]
  descripcion varchar(120) [not null]
  cantidad numeric(10,3) [not null]
  precio_unitario numeric(12,2) [not null, note: 'copia del precio de lista a crédito']
  subtotal numeric(12,2) [not null]
}

Table cuota {
  id serial [pk]
  compra_id int [not null, ref: > compra.id]
  numero smallint [not null]
  fecha_vencimiento date [not null]
  saldo_inicial numeric(12,2) [not null]
  interes numeric(12,2) [not null]
  amortizacion numeric(12,2) [not null]
  cuota numeric(12,2) [not null]
  saldo_final numeric(12,2) [not null]
  estado varchar(10) [not null, note: 'PENDIENTE | PAGADA']
  estado_cuenta_id int [ref: > estado_cuenta.id, note: 'listado que la cobra']
}

Table estado_cuenta {
  id serial [pk, note: 'listado de pago generado en la fecha de corte']
  tienda_id int [not null, ref: > tienda.id]
  cliente_id int [not null, ref: > cliente.id]
  fecha_corte date [not null]
  fecha_pago date [not null]
  moneda varchar(3) [not null]
  total_capital numeric(12,2) [not null]
  total_interes numeric(12,2) [not null]
  total_a_pagar numeric(12,2) [not null, note: 'sin mora']
  estado varchar(10) [not null, note: 'PENDIENTE | PAGADO']
  generado_en timestamptz
  indexes { (cliente_id, fecha_corte) [unique] }
}

Table pago {
  id serial [pk]
  tienda_id int [not null, ref: > tienda.id]
  cliente_id int [not null, ref: > cliente.id]
  estado_cuenta_id int [unique, not null, ref: - estado_cuenta.id, note: 'pago total, sin parciales']
  registrado_por int [not null, ref: > usuario.id]
  fecha_pago date [not null]
  dias_mora smallint [not null]
  monto_mora numeric(12,2) [not null, note: 'prelación 1']
  monto_interes numeric(12,2) [not null, note: 'prelación 2']
  monto_capital numeric(12,2) [not null, note: 'prelación 3']
  monto_total numeric(12,2) [not null]
  created_at timestamptz
}

Table tope_tasa {
  id serial [pk]
  tipo varchar(15) [not null, note: 'COMPENSATORIA | MORATORIA']
  tea_maxima numeric(12,7) [not null, note: '% TEA máxima BCRP']
  vigente_desde date [not null]
  fuente varchar(200)
  created_at timestamptz
  updated_at timestamptz
  indexes { (tipo, vigente_desde) [unique] }
}

Table bitacora {
  id bigserial [pk]
  usuario_id int [ref: > usuario.id]
  tienda_id int [ref: > tienda.id]
  accion varchar(40) [not null]
  entidad varchar(40) [not null]
  entidad_id bigint
  detalle jsonb
  ip varchar(45)
  created_at timestamptz
}
